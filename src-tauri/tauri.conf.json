{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CDJ Converter",
  "version": "0.1.0",
  "identifier": "com.odqc.cdjconverter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CDJ Converter",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Convierte música para que sea compatible con tus CDJ",
    "longDescription": "Revisa tus canciones contra el modelo de CDJ que vas a usar y crea copias convertidas de las que no son compatibles, conservando etiquetas y portadas.",
    "externalBin": ["binaries/ffmpeg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "languages": ["Spanish"],
        "installMode": "currentUser"
      }
    }
  }
}
